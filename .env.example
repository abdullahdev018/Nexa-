# Copy to .env and fill in.
#
#   cp .env.example .env
#   docker compose up -d        # start Postgres
#   npx prisma migrate deploy   # create the tables
#   npm run dev

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Matches the credentials in docker-compose.yml, so this works unedited with
# the bundled Postgres container.
DATABASE_URL="postgresql://nexa:nexa@localhost:5432/nexa_ai?schema=public"

# ---------------------------------------------------------------------------
# AI provider — server-side only
# ---------------------------------------------------------------------------
# This key never reaches the browser: every model request goes through
# /api/chat on the server. Get one from
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=""

# Optional. Selects the adapter in lib/ai/index.ts. Only "anthropic" ships
# today; add a provider there and name it here to switch.
AI_PROVIDER="anthropic"

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# Absolute origin, used for canonical URLs, Open Graph tags, robots.txt and
# sitemap.xml. Set this to the real domain in production.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
