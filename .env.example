# Copy to .env.local and fill in. `.env.local` is git-ignored; this file is the
# template and must never contain a real credential.
#
#   cp .env.example .env.local
#   docker compose up -d        # start Postgres
#   npx prisma migrate deploy   # create the tables
#   npm run dev

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Matches the credentials in docker-compose.yml, so this works unedited with
# the bundled Postgres container.
DATABASE_URL="postgresql://nexa:nexa@localhost:5432/nexa_ai?schema=public"

# ---------------------------------------------------------------------------
# AI provider — SERVER-SIDE ONLY
# ---------------------------------------------------------------------------
# Read only inside lib/ai/*, which is server-only. It is never sent to the
# browser, never logged, and must never be prefixed with NEXT_PUBLIC_.
# Get one from https://openrouter.ai/keys
OPENROUTER_API_KEY=""

# Optional. Selects the adapter in lib/ai/index.ts: "openrouter" (default) or
# "anthropic".
AI_PROVIDER="openrouter"

# Optional. Override which OpenRouter model backs each Nexa tier, so a tier can
# change without a deploy. See https://openrouter.ai/models for slugs.
# OPENROUTER_MODEL_SWIFT="anthropic/claude-haiku-4.5"
# OPENROUTER_MODEL_BALANCED="anthropic/claude-sonnet-4.5"
# OPENROUTER_MODEL_DEEP="anthropic/claude-opus-4.1"

# Only needed if AI_PROVIDER=anthropic.
# ANTHROPIC_API_KEY=""

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# Absolute origin, used for canonical URLs, Open Graph tags, robots.txt,
# sitemap.xml, and to identify this app to OpenRouter.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
